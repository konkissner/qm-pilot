# QM-Pilot production environment — copy to deploy/.env and fill values.
# Never commit deploy/.env

# --- Domain & TLS ---
APP_DOMAIN=qm.example.de
ACME_EMAIL=admin@example.de

# --- Container image (set by CI on deploy) ---
APP_IMAGE=ghcr.io/ORG/qm-pilot:latest
APP_REPLICAS=1

# --- PostgreSQL ---
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=
POSTGRES_DB=qmpilot
QMPILOT_APP_PASSWORD=
QMPILOT_MIGRATOR_PASSWORD=
DATABASE_URL=postgresql://qmpilot_app:CHANGE_ME@postgres:5432/qmpilot?schema=public
DATABASE_URL_MIGRATOR=postgresql://qmpilot_migrator:CHANGE_ME@postgres:5432/qmpilot?schema=public

# --- pgBackRest → Hetzner Storage Box (SFTP, different location than VM) ---
PGBACKREST_REPO_HOST=u123456.your-storagebox.de
PGBACKREST_REPO_USER=u123456
PGBACKREST_REPO_PORT=23
PGBACKREST_CIPHER_PASS=

# --- Hetzner Object Storage (S3, DE) ---
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_REGION=eu-central
S3_BUCKET=qm-pilot-prod
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- Auth (WP-03) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://qm.example.de

# --- Backup alarm SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=qm-pilot@example.de
ADMIN_ALERT_EMAIL=admin@example.de

# --- Worker ---
WORKER_TICK_INTERVAL_MS=60000
BACKUP_CHECK_INTERVAL_MS=3600000
