# QM-Pilot TEST environment — copy to deploy/.env on test VM.
# Test uses separate VM, domain, DB, and S3 bucket — seed data only (WP-01).

APP_DOMAIN=test-qm.example.de
ACME_EMAIL=admin@example.de

APP_IMAGE=ghcr.io/ORG/qm-pilot:main
APP_REPLICAS=1

POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=
POSTGRES_DB=qmpilot_test
QMPILOT_APP_PASSWORD=
QMPILOT_MIGRATOR_PASSWORD=
DATABASE_URL=postgresql://qmpilot_app:CHANGE_ME@postgres:5432/qmpilot_test?schema=public
DATABASE_URL_MIGRATOR=postgresql://qmpilot_migrator:CHANGE_ME@postgres:5432/qmpilot_test?schema=public

PGBACKREST_REPO_HOST=u654321.your-storagebox.de
PGBACKREST_REPO_USER=u654321
PGBACKREST_REPO_PORT=23
PGBACKREST_CIPHER_PASS=

S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_REGION=eu-central
S3_BUCKET=qm-pilot-test
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://test-qm.example.de

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=qm-pilot-test@example.de
ADMIN_ALERT_EMAIL=admin@example.de

WORKER_TICK_INTERVAL_MS=60000
BACKUP_CHECK_INTERVAL_MS=3600000
