# PostgreSQL connection (local dev: docker compose -f docker-compose.dev.yml up -d)
DATABASE_URL="postgresql://qmpilot:qmpilot@localhost:5432/qmpilot?schema=public"
# Runtime app role (append-only AuditEvent GRANTs) — use in production
DATABASE_URL_APP="postgresql://qmpilot_app:qmpilot_app@localhost:5432/qmpilot?schema=public"

# Better Auth (WP-03)
BETTER_AUTH_SECRET="dev-secret-minimum-32-characters-long"
BETTER_AUTH_URL="http://localhost:4321"
DEFAULT_TENANT_SLUG="pharmazeutika-73-3"
DEV_USER_PASSWORD="DevPassword12!"
AUTH_ENCRYPTION_KEY=""

# Hetzner Object Storage (WP-05) — optional for local dev
S3_ENDPOINT=""
S3_REGION="eu-central"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"

# Backup alarm SMTP (optional locally)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
ADMIN_ALERT_EMAIL=""
