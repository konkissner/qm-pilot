---
import '../styles/global.css';

const session = Astro.locals.session;
if (!session) return Astro.redirect('/login?next=/profile');
const readOnly = session.permissions.readOnly;
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Profil — QM-Pilot</title>
  </head>
  <body class="min-h-screen bg-[#eef1f0] p-6">
    {readOnly && (
      <div class="mb-4 rounded-[9px] bg-[#fff2d4] px-4 py-3 text-sm text-[#8a5a06]">
        Auditor-Modus — Lesezugriff
      </div>
    )}
    <main class="mx-auto max-w-lg rounded-[14px] border border-[#e6ebe9] bg-white p-6">
      <h1 class="text-xl font-bold text-[#16241f]">Profil</h1>
      <p class="mt-2 text-sm text-[#8a978f]">
        {session.user.firstName} {session.user.lastName}
        {session.user.email ? ` · ${session.user.email}` : ''}
      </p>
      {!readOnly && (
        <form id="password-form" class="mt-6 space-y-3">
          <label class="block text-sm">
            Neues Passwort (min. 12 Zeichen)
            <input type="password" name="password" minlength="12" class="mt-1 w-full rounded-[9px] border border-[#dce4e0] px-3 py-2" required />
          </label>
          <button type="submit" class="rounded-[9px] bg-[#0f6e56] px-4 py-2 text-white">Passwort ändern</button>
          <p id="pw-msg" class="text-sm text-[#8a978f]"></p>
        </form>
      )}
      <a href="/logout" class="mt-6 inline-block text-sm text-[#0f6e56]">Abmelden</a>
    </main>
    <script>
      document.getElementById('password-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(e.target as HTMLFormElement);
        const password = String(fd.get('password') ?? '');
        const res = await fetch('/api/auth/change-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ newPassword: password }),
        });
        const el = document.getElementById('pw-msg');
        if (el) el.textContent = res.ok ? 'Passwort gespeichert.' : 'Passwort konnte nicht geändert werden.';
      });
    </script>
  </body>
</html>
