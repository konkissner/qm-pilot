---
import '../styles/global.css';
import HelloIsland from '../islands/HelloIsland';

const session = Astro.locals.session;
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>QM-Pilot</title>
  </head>
  <body class="min-h-screen bg-[#eef1f0] text-[#16241f] antialiased">
    {session?.permissions.readOnly && (
      <div class="bg-[#fff2d4] px-4 py-2 text-center text-sm text-[#8a5a06]">
        Auditor-Modus — Lesezugriff
      </div>
    )}
    <main class="mx-auto flex max-w-2xl flex-col items-center justify-center gap-6 px-6 py-24">
      <h1 class="text-3xl font-bold tracking-tight">QM-Pilot Cockpit</h1>
      {session ? (
        <p class="text-center text-[#8a978f]">
          Angemeldet als {session.user.firstName} {session.user.lastName}
          {session.user.isKiosk ? ' (Kiosk)' : ''}
        </p>
      ) : (
        <p class="text-center text-[#8a978f]">
          <a href="/login" class="text-[#0f6e56] underline">Anmelden</a>
        </p>
      )}
      <HelloIsland client:load />
    </main>
  </body>
</html>
