---
import '../styles/global.css';
import HelloIsland from '../islands/HelloIsland';
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>QM-Pilot</title>
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900 antialiased">
    <main class="mx-auto flex max-w-2xl flex-col items-center justify-center gap-6 px-6 py-24">
      <h1 class="text-3xl font-bold tracking-tight">QM-Pilot — Fundament in Arbeit</h1>
      <p class="text-center text-gray-600">
        Mandantenfähiges eQMS für GDP-regulierte Betriebe. Dieses Repo ist das technische Fundament (WP-00).
      </p>
      <HelloIsland client:load />
    </main>
  </body>
</html>
