datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "node_modules/.zenstack/logical-prisma-client"
}

enum UserStatus {
  active
  retired
}

enum RightKind {
  module
  input
}

enum KioskDeviceStatus {
  active
  revoked
}

enum AuditorInviteStatus {
  pending
  active
  expired
}

enum HolidaySource {
  computed
  manual
}

enum FreightApprovalRule {
  rpAndQmb
  rpOnly
  qmbOnly
}

enum AuditSeverity {
  info
  warning
  critical
}

enum SignatureMeaning {
  created
  reviewed
  approved
  acknowledged
}

enum ReAuthMethod {
  password
  pin
}

enum SchedulerRunKind {
  workerTick
  backupFull
  backupCheck
  walArchiveCheck
}

enum SchedulerRunStatus {
  ok
  failed
}

/// @@deny('all', auth() == null)
/// @@allow('read', auth().tenantId == id)
model Tenant {
  id             String          @id() @default(cuid())
  name           String
