  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt()
  config         TenantConfig?
  users          User[]
  roles          Role[]
  roleRights     RoleRight[]
  userRights     UserRight[]
  holidays       Holiday[]
  kioskDevices   KioskDevice[]
  auditorInvites AuditorInvite[]
  auditEvents    AuditEvent[]
  signatures     Signature[]
}

